---
// Демо-стенд для вау-эффектов: каждый эффект на своей странице, до встраивания в лендинг.
import Base from "./Base.astro";
import "../styles/components.css";
import "../styles/b.css";
import "../styles/lab.css";

interface Props {
  n: number;
  title: string;
  lead: string;
  notes: string[];
}
const { n, title, lead, notes } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const TOTAL = 5;
---
<Base title={`${title} — лаборатория Party Time`} theme="#151515" favicon="blue" bodyClass="vb lab" noindex>
  <header class="lab__bar">
    <a class="lab__logo" href={`${base}/lab`}>
      <img src={`${base}/brand/logo-karaoke-loft.svg`} alt="Party Time" width="104" height="54" />
      <span>Лаборатория</span>
    </a>
    <nav class="lab__nav" aria-label="Эффекты">
      {Array.from({ length: TOTAL }, (_, i) => (
        <a href={`${base}/lab/${i + 1}`} aria-current={i + 1 === n ? "page" : undefined}>{i + 1}</a>
      ))}
    </nav>
  </header>
  <section class="lab__intro container">
    <p class="lab__num num">0{n} / 0{TOTAL}</p>
    <h1>{title}</h1>
    <p class="lab__lead">{lead}</p>
    <ul class="lab__notes">
      {notes.map((x) => <li set:html={x} />)}
    </ul>
  </section>
  <main class="lab__stage">
    <slot />
  </main>
</Base>
