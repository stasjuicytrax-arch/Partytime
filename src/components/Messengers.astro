---
// Мессенджеры — главный канал заявок (4,45% конверсии на старом сайте).
// Телефон: закреплённая нижняя панель на всех экранах. ПК: плавающая «Написать нам», видна всегда.
// Ссылка в бота несёт метку текущей секции: site_hero, site_rooms, … (см. docs/TZ.md).
// MAX — ссылку заказчик пока не дал [уточнить]: кнопка появится, как только она будет в content.ts.
import Icon from "./Icon.astro";
import { MESSENGERS, PHONE_MAIN } from "../lib/content";
import { tel } from "../lib/rooms";
import { botUrl } from "../lib/bot";
import { isPlaceholder } from "../config/offer";
const tg = botUrl("site_hero");
const hasMax = !isPlaceholder(MESSENGERS.max.href);
---
<!-- телефон: нижняя панель -->
<nav class="mbar" aria-label="Написать или позвонить" data-place="bar">
  <a class="mbar__item mbar__item--tg" href={tg} target="_blank" rel="noopener" data-bot-dynamic>
    <span class="mbar__dot" aria-hidden="true"></span>Telegram
  </a>
  <a class="mbar__item" href={MESSENGERS.vk.href} target="_blank" rel="noopener">VK</a>
  {hasMax && <a class="mbar__item" href={MESSENGERS.max.href} target="_blank" rel="noopener">MAX</a>}
  <a class="mbar__item mbar__item--call" href={tel(PHONE_MAIN)}><Icon name="phone" size={18} />Позвонить</a>
</nav>

<!-- ПК: плавающая кнопка -->
<div class="msgr" data-msgr data-place="fab">
  <ul class="msgr__list" id="msgr-list" inert>
    <li><a class="msgr__item msgr__item--tg" href={tg} target="_blank" rel="noopener" data-bot-dynamic>Telegram</a></li>
    <li><a class="msgr__item" href={MESSENGERS.vk.href} target="_blank" rel="noopener">VK</a></li>
    {hasMax && <li><a class="msgr__item" href={MESSENGERS.max.href} target="_blank" rel="noopener">MAX</a></li>}
    <li><a class="msgr__item num" href={tel(PHONE_MAIN)}><Icon name="phone" size={16} />{PHONE_MAIN}</a></li>
  </ul>
  <button type="button" class="msgr__btn" aria-label="Написать нам" aria-expanded="false" aria-controls="msgr-list" data-msgr-btn>
    <span class="msgr__label">Написать нам</span>
    <span class="msgr__ico" aria-hidden="true"><Icon name="chat" size={22} class="msgr__i-chat" /><Icon name="close" size={20} class="msgr__i-close" /></span>
  </button>
</div>

<script>
  import { botUrl } from "../lib/bot";
  import { initClickGoals } from "../lib/analytics";
  initClickGoals();
  const root = document.querySelector<HTMLElement>("[data-msgr]");
  if (root) {
    const btn = root.querySelector<HTMLButtonElement>("[data-msgr-btn]")!;
    const toggle = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      root.classList.toggle("is-open", open);
      // закрытый список не ловит Tab
      root.querySelector<HTMLElement>("#msgr-list")!.inert = !open;
    };
    btn.addEventListener("click", () => toggle(btn.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && root.classList.contains("is-open")) {
        toggle(false);
        btn.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (root.classList.contains("is-open") && !root.contains(e.target as Node)) toggle(false);
    });
    // пока виден первый экран, кнопка компактная
    const hero = document.querySelector("[data-hero-a], [data-hero-b]");
    if (hero) {
      root.classList.add("is-compact");
      new IntersectionObserver((en) => root.classList.toggle("is-compact", en[0].intersectionRatio > 0.35), { threshold: [0, 0.35, 0.6, 1] }).observe(hero);
    }
  }

  // метка бота = секция, которую человек сейчас смотрит
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-bot-dynamic]")];
  const sections = [...document.querySelectorAll<HTMLElement>("section[id], [data-hero-a], [data-hero-b], footer")];
  const nameOf = (el: HTMLElement) => (el.matches("[data-hero-a], [data-hero-b]") ? "hero" : el.tagName === "FOOTER" ? "footer" : el.id);
  const visible = new Map<HTMLElement, number>();
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => visible.set(en.target as HTMLElement, en.intersectionRatio));
      let best: HTMLElement | null = null;
      let max = 0;
      visible.forEach((r, el) => {
        if (r > max) {
          max = r;
          best = el;
        }
      });
      if (best) {
        const url = botUrl(`site_${nameOf(best)}`);
        links.forEach((a) => (a.href = url));
      }
    },
    { threshold: [0, 0.25, 0.5, 0.75, 1] }
  );
  sections.forEach((s) => io.observe(s));
</script>
