---
import Icon from "./Icon.astro";
import { OFFER } from "../config/offer";
import {
  rooms,
  locations,
  GROUPS,
  groupById,
  INCLUDED,
  PROMO,
  rub,
  capacityLabel,
  roomAlt,
  roomsClientData,
  totalRooms,
  tel,
  PHONE_MAIN,
} from "../lib/rooms";
import { botUrl } from "../lib/bot";

interface Props {
  variant: "a" | "b" | "c";
  /** карточки ведут на страницы залов /zal/<slug> (без всплывающего окна) */
  pages?: boolean;
}
const { variant, pages = false } = Astro.props;
const zalBase = import.meta.env.BASE_URL.replace(/\/$/, "");
// по умолчанию — все локации сразу
const DEFAULT_LOC = "all";
const countIn = (loc: string, g?: string) => rooms.filter((r) => (loc === "all" || r.loc === loc) && (!g || r.group === g)).length;
const activeLocs = locations.filter((l) => l.active);
// карточка 4:5, а фото 3:2 — при object-fit: cover картинка шире карточки в ~1.9 раза
// (на телефоне карточка 5:4 — в ~1.2 раза); sizes считаем по реальной ширине фото, иначе браузер берёт мелкую версию
// каталог ниже первого экрана: при загрузке не тянем ни одного фото залов — адреса подставляет скрипт,
// когда до сетки остаётся ~300px прокрутки (catalog.ts, near). Так первый экран открывается быстрее.
const eager = new Set<string>();
const sizes = "(max-width: 559px) 112vw, (max-width: 767px) 56vw, (max-width: 1023px) 86vw, (max-width: 1439px) 58vw, 825px";
---
<section id="rooms" class={`rc rc--${variant}`} aria-labelledby="rooms-title" data-catalog>
  <div class="container rc__inner">
    <header class="rc__head">
      <p class="rc__label">01 — Залы</p>
      <h2 id="rooms-title" class="rc__title">
        <span class="w-fill">Найди</span>
        <span class="w-outline outline-word">свой</span>
        <span class="w-mark"><span>зал</span></span>
      </h2>
      <p class="rc__lead">
        {totalRooms} тематических миров на&nbsp;{locations.filter((l) => l.active).length}&nbsp;локациях. Выберите локацию и&nbsp;размер компании.
      </p>
    </header>

    <div class="rc__controls">
      <div class="rc__scroll" data-scroll-hint>
      <div class="rc__locs" role="group" aria-label="Локация">
        <button type="button" class="loc loc--all" data-loc="all" aria-pressed={DEFAULT_LOC === "all" ? "true" : "false"} style="--loc: var(--pt-lime)">
          <span class="loc__name">Все локации</span>
          <span class="loc__meta">{rooms.length} залов · {activeLocs.length}&nbsp;адреса</span>
        </button>
        {
          activeLocs.map((l) => (
            <button
              type="button"
              class="loc"
              data-loc={l.id}
              aria-pressed={l.id === DEFAULT_LOC ? "true" : "false"}
              style={`--loc: var(--c-loc-${l.id})`}
            >
              <span class="loc__name">{l.name}</span>
              <span class="loc__meta">{countIn(l.id)} залов · {l.address}</span>
            </button>
          ))
        }
      </div>
        <span class="rc__hint" aria-hidden="true"><Icon name="next" size={18} /></span>
      </div>

      <div class="rc__scroll" data-scroll-hint data-filters-wrap>
      <div class="rc__filters" role="group" aria-label="Сколько гостей">
        <button type="button" class="chip" data-group="all" aria-pressed="true">
          Все <span class="chip__n num" data-count="all">{countIn(DEFAULT_LOC)}</span>
        </button>
        {
          GROUPS.map((g) => (
            <button type="button" class="chip" data-group={g.id} aria-pressed="false" style={`--g: ${g.color}`}>
              {g.label} гостей <span class="chip__n num" data-count={g.id}>{countIn(DEFAULT_LOC, g.id)}</span>
            </button>
          ))
        }
      </div>
        <span class="rc__hint" aria-hidden="true"><Icon name="next" size={18} /></span>
      </div>
    </div>

    <p class="visually-hidden" aria-live="polite" data-status></p>

    <ul class="rc__grid" data-grid>
      {
        rooms.map((r, i) => (
          <li
            class="card"
            data-loc={r.loc}
            data-group={r.group}
            data-slug={r.slug}
            hidden={DEFAULT_LOC === "all" ? i >= 6 : r.loc !== DEFAULT_LOC}
            style={`--g: ${groupById[r.group].color}; --tilt: ${[-1, 0.6, -0.4, 1, -0.8, 0.3][i % 6]}deg`}
          >
            <a class="card__link" href={pages ? `${zalBase}/zal/${r.slug}/` : `#room-${r.slug}`}>
              <div class="card__media" data-count={r.images.length}>
                {r.images.map((im, j) => (
                  <img
                    class={j === 0 ? "is-active" : undefined}
                    src={j === 0 && eager.has(r.slug) ? im.src : undefined}
                    srcset={j === 0 && eager.has(r.slug) ? im.srcset : undefined}
                    data-src={j === 0 && eager.has(r.slug) ? undefined : im.src}
                    data-srcset={j === 0 && eager.has(r.slug) ? undefined : im.srcset}
                    sizes={sizes}
                    alt={j === 0 ? roomAlt(r) : ""}
                    width="960"
                    height="640"
                    loading="lazy"
                    decoding="async"
                  />
                ))}
                {r.images.length > 1 && (
                  <div class="card__dots" aria-hidden="true">
                    {r.images.map((_, j) => (
                      <span class={j === 0 ? "is-active" : undefined} />
                    ))}
                  </div>
                )}
                <div class="card__badges">
                  <span class="badge badge--cap">{capacityLabel(r)}</span>
                  {r.area && <span class="badge num">{r.area}&nbsp;м²</span>}
                </div>
                <span class="card__price num">
                  от&nbsp;{rub(r.price)}
                  <small>/час</small>
                </span>
                <span class="card__cta" aria-hidden="true">
                  Смотреть зал <Icon name="arrow" size={18} />
                </span>
              </div>
              <div class="card__body">
                <p class="card__loc" style={`--loc: var(--c-loc-${r.loc})`}>{r.locName}</p>
                <h3 class="card__title">{r.title}</h3>
                <p class="card__tag">{r.tagline}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="rc__more" data-more hidden>
      <button type="button" class="btn btn--primary rc__more-btn" data-more-btn data-magnetic>
        <span data-more-label>Показать все залы</span>
        <span class="btn__ico"><Icon name="arrow" size={20} /></span>
      </button>
    </div>

    <div class="rc__empty" data-empty hidden>
      <p>Под такую компанию здесь залов нет&nbsp;— посмотрите все размеры.</p>
      <button type="button" class="chip" data-reset>Показать все залы</button>
    </div>
  </div>

  {!pages && (<dialog class={`rm rm--${variant}`} aria-labelledby="rm-title" data-modal data-lenis-prevent>
    <div class="rm__panel">
      <button type="button" class="rm__close" data-close aria-label="Закрыть">
        <Icon name="close" />
      </button>
      <div class="rm__gallery" data-gallery>
        <div class="rm__track" data-track></div>
        <button type="button" class="rm__nav rm__nav--prev" data-prev aria-label="Предыдущее фото">
          <Icon name="prev" />
        </button>
        <button type="button" class="rm__nav rm__nav--next" data-next aria-label="Следующее фото">
          <Icon name="next" />
        </button>
        <span class="rm__count num" data-counter></span>
        <!-- на последнем фото: не впечатлил зал — сразу к следующему -->
        <button type="button" class="rm__nextroom" data-next-room="photo" hidden>
          <span>Следующий зал:</span> <b data-next-name></b><Icon name="next" size={18} />
        </button>
      </div>
      <!-- превью всех фото зала под большим фото -->
      <div class="rm__thumbs" data-thumbs role="group" aria-label="Фотографии зала"></div>
      <!-- ПК: ряд под фото, виден сразу; телефон: после описания -->
      <div class="rm__similar" data-similar>
        <!-- две вкладки: та же вместимость / залы на компанию поменьше -->
        <div class="rm__simtabs" role="tablist" aria-label="Другие залы">
          <button type="button" role="tab" id="rm-tab-same" aria-controls="rm-sim-list" aria-selected="true" data-simtab="same">Похожие залы</button>
          <button type="button" role="tab" id="rm-tab-smaller" aria-controls="rm-sim-list" aria-selected="false" data-simtab="smaller">Залы поменьше</button>
        </div>
        <ul class="rm__sim" id="rm-sim-list" role="tabpanel" aria-labelledby="rm-tab-same" data-sim-list></ul>
      </div>
      <div class="rm__info">
        <!-- листалка залов: в том же порядке и с теми же фильтрами, что в каталоге -->
        <div class="rm__pager" data-pager>
          <button type="button" data-room-step="-1" aria-label="Предыдущий зал"><Icon name="prev" size={18} /></button>
          <span class="num" data-pager-count aria-live="polite"></span>
          <button type="button" data-room-step="1" aria-label="Следующий зал"><Icon name="next" size={18} /></button>
        </div>
        <div class="rm__body">
        <p class="rm__loc" data-f="loc"></p>
        <h3 id="rm-title" class="rm__title" data-f="title"></h3>
        <p class="rm__tagline" data-f="tagline"></p>
        <div class="rm__meta">
          <div class="rm__badges" data-f="badges"></div>
          <p class="rm__price num">от&nbsp;<b data-f="price"></b><span>/час</span></p>
        </div>
        <p class="rm__text" data-f="text"></p>
        <div class="rm__included">
          <h4>Входит в&nbsp;аренду</h4>
          <ul>
            {INCLUDED.map((x) => <li>{x}</li>)}
          </ul>
        </div>
        <p class="rm__promo">{PROMO}</p>
        <!-- в конце описания — следующий зал -->
        <button type="button" class="rm__nextcard" data-next-room="card">
          <span class="rm__nextcard-img" data-next-img></span>
          <span class="rm__nextcard-text">
            <span class="rm__nextcard-label">Следующий зал</span>
            <b data-next-name></b>
            <span class="rm__sim-facts" data-next-facts></span>
          </span>
          <Icon name="next" size={22} />
        </button>
        </div>
        <div class="rm__foot" data-place="room_modal">
          <a class="btn btn--primary rm__book" href="#booking" data-book>
            <span>Забронировать<span class="visually-hidden"> этот зал</span></span>
            <span class="btn__ico"><Icon name="arrow" size={20} /></span>
          </a>
          <a class="btn rm__tg" href="#" target="_blank" rel="noopener" data-room-tg>
            <span>{OFFER.room}</span>
          </a>
        </div>
      </div>
    </div>
  </dialog>)}

  <script type="application/json" id="rooms-data" set:html={JSON.stringify(roomsClientData)} />
</section>

<script>
  import { initCatalog } from "../scripts/catalog";
  document.querySelectorAll<HTMLElement>("[data-catalog]").forEach(initCatalog);
</script>
