---
import { FOOTER, PHONE_MAIN, MESSENGERS } from "../../lib/content";
import { tel } from "../../lib/rooms";
import { botUrl } from "../../lib/bot";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (h: string) => (h === "soon" || h === "menu" ? `${base}/${h}` : h);
const word = ["В", "Е", "С", "Е", "Л", "И", "М", "С", "Я"];
const fills = ["lime", "pink", "white", "sky", "violet", "pink", "lime", "white", "saffron"];
---
<footer class="ft" aria-label="Подвал сайта">
  <div class="container ft__cols">
    <div class="ft__brand">
      <img src={`${base}/brand/logo-primary.svg`} alt="Время веселиться — пространство для праздника" width="170" height="86" loading="lazy" />
      <a class="ft__tel num" href={tel(PHONE_MAIN)}>{PHONE_MAIN}</a>
      <div class="ft__msg">
        <a href={botUrl("site_footer")} target="_blank" rel="noopener">Telegram</a>
        <a href={MESSENGERS.vk.href} target="_blank" rel="noopener">VK</a>
        <a href={MESSENGERS.channel.href} target="_blank" rel="noopener">Канал с&nbsp;акциями</a>
      </div>
    </div>
    <nav aria-label="Гостям">
      <b>Гостям</b>
      {FOOTER.guests.map((l) => <a href={href(l.href)}>{l.label}</a>)}
    </nav>
    <nav aria-label="Компания">
      <b>Компания</b>
      {FOOTER.company.map((l) => (
        <a href={href(l.href)}>{l.label}{"note" in l && l.note && <small>{l.note}</small>}</a>
      ))}
    </nav>
    <nav aria-label="Документы">
      <b>Документы</b>
      {FOOTER.docs.map((l) => <a href={href(l.href)}>{l.label}</a>)}
    </nav>
  </div>

  <div class="ft__stage" data-letters aria-hidden="true">
    {word.map((l, i) => <span class={`ft-letter ft-letter--${fills[i]}`} data-letter>{l}</span>)}
  </div>

  <p class="container ft__copy">© 2026 Время веселиться. Пространство для праздника.</p>
</footer>
