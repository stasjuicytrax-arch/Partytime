---
import Icon from "../Icon.astro";
import BdayDates from "../BdayDates.astro";
import { FORMATS } from "../../lib/content";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<section class="sec formats" id="formats" aria-labelledby="formats-title" data-formats>
  <div class="formats__pin" data-formats-pin>
    <div class="container formats__head">
      <p class="sec__label">03 — Форматы</p>
      <h2 id="formats-title" class="sec__title">Повод <span class="sec__accent">найдётся</span></h2>
      <p class="sec__lead">Выберите формат — и&nbsp;мы подставим его в&nbsp;заявку.</p>
    </div>
    <div class="formats__viewport" data-formats-viewport>
      <ol class="formats__track" data-formats-track>
        {FORMATS.map((f, i) => {
          const stem = `${base}/img/rooms/${f.room}/02`;
          return (
            <li class="fcard" style={`--i:${i}`}>
              <img
                class="fcard__photo"
                src={`${stem}-960.webp`}
                srcset={`${stem}-480.webp 480w, ${stem}-960.webp 960w`}
                sizes="(max-width: 767px) 140vw, 640px"
                alt=""
                width="960"
                height="640"
                loading="lazy"
                decoding="async"
              />
              <span class="fcard__num num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div class="fcard__body">
                <h3>{f.title}</h3>
                <p>{f.text}</p>
                <button type="button" class="fcard__btn" data-format={f.form} data-format-title={f.title}>
                  Хочу так <Icon name="arrow" size={18} />
                </button>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
    <p class="container formats__note">Новый год, 14 и&nbsp;23 февраля — сезонные форматы, расскажет менеджер.</p>
  </div>
  <div class="container"><BdayDates /></div>
</section>
