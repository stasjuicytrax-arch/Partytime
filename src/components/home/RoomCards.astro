---
// Простые карточки залов (как на маркетплейсе): фото, название, локация, гости, цена. Ссылка на зал.
import Icon from "../Icon.astro";
import { rub, capacityLabel, type Room } from "../../lib/rooms";

interface Props {
  list: Room[];
}
const { list } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<ul class="zgrid">
  {list.map((r) => (
    <li>
      <a class="zcard" href={`${base}/zal/${r.slug}/`}>
        <img
          src={r.images[0].src}
          srcset={r.images[0].srcset}
          sizes="(max-width: 767px) 50vw, (max-width: 1279px) 33vw, 25vw"
          alt={`Зал «${r.title}», ${r.locName}`}
          width="960"
          height="640"
          loading="lazy"
          decoding="async"
        />
        <span class="zcard__price num">от {rub(r.price)}<small>/час</small></span>
        <h3>{r.title}</h3>
        <span class="zcard__meta"><Icon name="pin" size={14} />{r.locName}</span>
        <span class="zcard__meta"><Icon name="users" size={14} />{capacityLabel(r)}</span>
      </a>
    </li>
  ))}
</ul>
