---
// Первый экран главной: лента из 5 фото со свайпом, H1 и два пути — «Выбрать зал» и «Выбрать повод».
// Под кнопками — локации: тап сразу открывает каталог на нужной локации (быстрый путь «локация → зал → бронь»).
import Icon from "../Icon.astro";
import { rooms, locations, networkRooms, minPrice, rub } from "../../lib/rooms";

const picks = ["brooklyn", "maiami-bich", "odnazhdy-v-gollivude", "gavaji", "disco"]
  .map((slug) => rooms.find((r) => r.slug === slug))
  .filter((r): r is (typeof rooms)[number] => !!r);
const locs = locations.filter((l) => l.active);
const countIn = (id: string) => rooms.filter((r) => r.loc === id).length;
---
<section class="hm" aria-labelledby="hero-title">
  <div class="container hm__copy">
    <h1 id="hero-title" class="hm__title">
      Время веселиться<span class="hm__sub">залы с&nbsp;караоке для вашей компании в&nbsp;Петербурге</span>
    </h1>
    <p class="hm__lead num">{networkRooms} тематических залов, от&nbsp;{rub(minPrice)} в&nbsp;час. Весь зал только ваш.</p>
    <div class="hm__ctas">
      <a class="hm__btn hm__btn--main" href="#rooms">Выбрать зал <Icon name="arrow" size={18} /></a>
      <a class="hm__btn" href="#formats">Выбрать повод</a>
    </div>
  </div>

  <ul class="hm__strip" aria-label="Залы — листайте">
    {picks.map((r, i) => (
      <li>
        <a class="hm__photo" href={`#room-${r.slug}`}>
          <img
            src={r.images[0].src}
            srcset={r.images[0].srcset}
            sizes="(max-width: 767px) 78vw, 30vw"
            alt={`Зал «${r.title}», ${r.locName}`}
            width="960"
            height="640"
            loading={i < 2 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : undefined}
            decoding="async"
          />
          <span class="hm__cap">{r.title}<small>{r.locName}</small></span>
        </a>
      </li>
    ))}
  </ul>

  <nav class="container hm__locs" aria-label="Залы по локациям">
    {locs.map((l) => (
      <a href="#rooms" data-goloc={l.id}>
        <span>{l.name}</span><small class="num">{countIn(l.id)} залов</small>
      </a>
    ))}
  </nav>
</section>

<script>
  // тап по локации: включаем её вкладку в каталоге (логика каталога та же — обычный клик по кнопке) и едем к залам
  document.querySelectorAll<HTMLAnchorElement>("[data-goloc]").forEach((a) =>
    a.addEventListener("click", () => {
      document.querySelector<HTMLButtonElement>(`#rooms .loc[data-loc="${a.dataset.goloc}"]`)?.click();
    })
  );
</script>
