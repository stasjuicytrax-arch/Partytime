---
interface Props { id: string }
const { id } = Astro.props;
const symbols: Record<string, { color: string; path: string }> = {
  mafia: { color: "violet-l", path: '<path d="M3.5 8.8c2.8-.8 5.3-.6 7.2.8a2.2 2.2 0 0 0 2.6 0c1.9-1.4 4.4-1.6 7.2-.8-.4 4.5-1.9 7.5-4.8 7.5-1.8 0-2.3-1.9-3.7-1.9s-1.9 1.9-3.7 1.9c-2.9 0-4.4-3-4.8-7.5Z"/><path d="m6.7 12 2.3.7m8.3-.7-2.3.7"/>' },
  menu: { color: "saffron", path: '<path d="M4 17h16M5.5 14.5a6.5 6.5 0 0 1 13 0M12 8V6m-1 0h2M7 19.5h10"/>' },
  tg: { color: "sky", path: '<path d="m20.6 4.8-3.7 14.5-5-4.1-3 2.7.5-5.1 8.1-5.5-9.8 4.1-4.4-1.6 17.3-5Z"/>' },
  loyalty: { color: "lime", path: '<circle cx="10" cy="10" r="5.8"/><path d="M15.6 9.3a5.8 5.8 0 1 1-6.3 6.3M10 7.5v5m-2.5-2.5h5"/>' },
};
const symbol = symbols[id];
---

{symbol && (
  <span class="promo-symbol" style={"--promo-symbol-color: var(--pt-" + symbol.color + ")"} aria-hidden="true">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={symbol.path} />
  </span>
)}

<style>
  .promo-symbol {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 12px;
    border-radius: 12px;
    background-color: var(--promo-symbol-color);
    color: var(--pt-deep);
  }
</style>
