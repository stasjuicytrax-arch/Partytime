---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="disco-ball" data-catalog-disco>
  <img src={base + "/img/ball-poster.webp"} alt="" width="460" height="460" loading="lazy" decoding="async" />
  <canvas aria-hidden="true"></canvas>
</div>

<style>
  .disco-ball { position: relative; isolation: isolate; width: 100%; aspect-ratio: 1; }
  .disco-ball::before {
    position: absolute;
    z-index: -1;
    inset: -12% 0 -12% -12%;
    content: "";
    pointer-events: none;
    background: radial-gradient(closest-side, rgb(118 89 255 / 0.25), rgb(254 118 180 / 0.09) 66%, transparent);
  }
  .disco-ball img, .disco-ball canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .disco-ball canvas { visibility: hidden; }
  .disco-ball[data-rendered] canvas { visibility: visible; }
  .disco-ball[data-rendered] img { visibility: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .disco-ball[data-rendered] canvas { visibility: hidden; }
    .disco-ball[data-rendered] img { visibility: visible; }
  }
</style>

<script>
  import type { DiscoBall } from "../../scripts/disco";

  const root = document.querySelector<HTMLElement>("[data-catalog-disco]");
  const canvas = root?.querySelector("canvas");
  if (root && canvas && "IntersectionObserver" in window && "ResizeObserver" in window) {
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
    let ball: DiscoBall | null = null;
    let visible = false;
    let played = false;
    let timer = 0;
    let loading = false;
    let unavailable = false;

    const onScreen = () => visible && !motion.matches && !document.hidden && !unavailable;
    const stop = () => {
      window.clearTimeout(timer);
      ball?.stop();
    };

    const update = async () => {
      if (!onScreen()) {
        stop();
        return;
      }
      if (!ball && !loading) {
        loading = true;
        try {
          const { createDiscoBall } = await import("../../scripts/disco");
          if (!onScreen()) return;
          ball = createDiscoBall(canvas, { mobile: matchMedia("(max-width: 767px)").matches });
          ball.renderOnce();
          root.setAttribute("data-rendered", "");
        } catch {
          unavailable = true;
        } finally {
          loading = false;
        }
      }
      if (ball && onScreen() && !played) {
        played = true;
        ball.start();
        timer = window.setTimeout(stop, 4800);
      }
    };

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (!visible) played = false;
      void update();
    }).observe(root);

    new ResizeObserver(() => {
      if (!ball || unavailable) return;
      ball.resize();
      ball.renderOnce();
    }).observe(root);

    root.addEventListener("pointermove", (event) => {
      if (!ball || !finePointer.matches || motion.matches || event.pointerType !== "mouse") return;
      const rect = root.getBoundingClientRect();
      ball.setPointer((event.clientX - rect.left) / rect.width - 0.5, (event.clientY - rect.top) / rect.height - 0.5);
    }, { passive: true });
    root.addEventListener("pointerleave", () => ball?.setPointer(0, 0));
    document.addEventListener("visibilitychange", update);
    motion.addEventListener("change", update);
    canvas.addEventListener("webglcontextlost", () => {
      unavailable = true;
      stop();
      root.removeAttribute("data-rendered");
    });
  }
</script>
