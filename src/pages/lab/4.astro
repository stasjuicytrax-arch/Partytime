    "<b>Телефон:</b> эффект выключен, остаётся свайп фото",
    "<b>Без анимации:</b> выключен",
  ]}
>
  <RoomCatalog variant="b" />
</Lab>

<script>
  import { initCursor } from "../../scripts/motion";
  import { initLiquid } from "../../scripts/fx/liquid";
