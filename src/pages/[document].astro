---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/sections/Footer.astro";
import Icon from "../components/Icon.astro";
import { FOOTER } from "../lib/content";
import "../styles/components.css";
import "../styles/b.css";
import "../styles/sections.css";
import "../styles/theme-dark.css";

export function getStaticPaths() {
  return FOOTER.docs.map(({ href, label, heading }) => ({
    params: { document: href },
    props: { heading: heading ?? label },
  }));
}

const { heading } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pdf = `${base}/documents/${Astro.params.document}.pdf`;
---

<Base title={`${heading} — Время веселиться`} description={`${heading}. Документы Party Time.`} theme="#151515" favicon="blue" bodyClass="vb">
  <SiteHeader variant="b" home={false} />
  <main id="main" class="doc" tabindex="-1">
    <div class="container doc__inner">
      <h1>{heading}</h1>
      <div class="doc__actions">
        <a class="btn btn--primary btn--sm" href={pdf} target="_blank" rel="noopener" aria-label="Открыть PDF в новой вкладке">
          Открыть PDF<span class="btn__ico"><Icon name="arrow" size={18} /></span>
        </a>
        <a class="btn btn--ghost btn--sm" href={pdf} download>Скачать PDF</a>
      </div>
      <object class="doc__preview" data={pdf} type="application/pdf" aria-label={heading}>
        <p>Предпросмотр PDF недоступен в этом браузере. <a href={pdf}>Открыть документ</a>.</p>
      </object>
    </div>
  </main>
  <Footer home={false} />
</Base>

<style>
  .doc {
    background: var(--t-bg);
    color: var(--t-text);
    color-scheme: dark;
    padding-block: clamp(112px, 10vw, 152px) var(--section-y);
  }
  .doc__inner { max-width: 1120px; }
  h1 {
    font-size: clamp(1.5rem, 3.8vw, 3.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .doc__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-block: var(--s-5) var(--s-6);
  }
  .doc__preview {
    display: block;
    position: relative;
    z-index: 7;
    width: 100%;
    height: clamp(380px, 72svh, 900px);
    border: 1px solid var(--t-line-strong);
    border-radius: var(--t-radius);
    overflow: hidden;
    background: var(--t-surface);
  }
  .doc__preview p { padding: var(--s-5); }
  .doc__preview a:hover { color: var(--t-accent); }
</style>
