---
// Главная (тёмная тема): первый экран с двумя путями — «Выбрать зал» и «Выбрать повод», дальше каталог залов.
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import HeroMain from "../components/home/HeroMain.astro";
import RoomCatalog from "../components/RoomCatalog.astro";
import VideoBlock from "../components/home/VideoBlock.astro";
import Perks from "../components/home/Perks.astro";
import MoreLinks from "../components/home/MoreLinks.astro";
import Occasions from "../components/home/Occasions.astro";
import Services from "../components/sections/Services.astro";
import PromoCards from "../components/home/PromoCards.astro";
import Reviews from "../components/sections/Reviews.astro";
import Booking from "../components/sections/Booking.astro";
import Faq from "../components/sections/Faq.astro";
import Contacts from "../components/sections/Contacts.astro";
import Footer from "../components/sections/Footer.astro";
import Messengers from "../components/Messengers.astro";
import Popups from "../components/Popups.astro";
import JsonLd from "../components/JsonLd.astro";
import "../styles/components.css";
import "../styles/b.css";
import "../styles/sections.css";
import "../styles/theme-dark.css";
import "../styles/home.css";

---
<Base theme="#151515" favicon="blue" bodyClass="vb">
  <JsonLd slot="head" />
  <SiteHeader variant="b" />
  <main id="main" tabindex="-1">
    <HeroMain />
    <RoomCatalog variant="b" />
    <Occasions />
    <PromoCards />
    <VideoBlock />
    <Perks />
    <Services />
    <Booking />
    <Reviews />
    <Faq />
    <Contacts />
    <MoreLinks />
  </main>
  <Footer />
  <Messengers />
  <Popups />
</Base>

<script>
  import { initSmoothScroll } from "../scripts/motion";
  import { initReveals, initClock, initServices, initFaq } from "../scripts/sections";
  import { initBooking } from "../scripts/booking";
  initSmoothScroll();
  const idle = (fn: () => void) => ("requestIdleCallback" in window ? requestIdleCallback(fn, { timeout: 2000 }) : setTimeout(fn, 800));

  // секции ниже первого экрана: на телефоне настраиваем, когда браузер освободится после загрузки
  const initSections = () => {
    initReveals();
    initClock();
    initServices();
    initFaq();
    initBooking(document.querySelector<HTMLElement>("[data-booking]")!);
  };
  if (matchMedia("(pointer: coarse)").matches) {
    document.readyState === "complete" ? idle(initSections) : addEventListener("load", () => idle(initSections), { once: true });
  } else initSections();

  // вау-эффекты — лениво, после загрузки страницы
  // падающие буквы в подвале — физика грузится за 400px до подвала
  const stage = document.querySelector<HTMLElement>("[data-letters]");
  if (stage) {
    const io = new IntersectionObserver(async (en) => {
      if (!en[0].isIntersecting) return;
      io.disconnect();
      const { initLetters } = await import("../scripts/fx/letters");
      initLetters(stage);
    }, { rootMargin: "400px" });
    io.observe(stage);
  }

  addEventListener("load", () =>
    idle(async () => {
      const { initLiquid } = await import("../scripts/fx/liquid");
      initLiquid(document.getElementById("rooms")!);
    })
  );
</script>
