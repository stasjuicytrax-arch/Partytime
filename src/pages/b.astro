---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import HeroB from "../components/b/HeroB.astro";
import Marquee from "../components/Marquee.astro";
import RoomCatalog from "../components/RoomCatalog.astro";
import NextUp from "../components/NextUp.astro";
import Messengers from "../components/Messengers.astro";
import Popups from "../components/Popups.astro";
import "../styles/components.css";
import "../styles/b.css";

const strip = ["Караоке", "Своя кухня", "Авторский бар", "PS5 и Nintendo Switch", "Без пробкового сбора", "До 06:00", "Только свои"];
---
<Base title="Время веселиться — вариант B «Ночной лофт»" theme="#151515" favicon="blue" bodyClass="vb" noindex>
  <SiteHeader variant="b" />
  <main>
    <HeroB />
    <div class="mb marquee">
      <p class="visually-hidden">{strip.join(", ")}</p>
      <div aria-hidden="true">
        <Marquee items={strip} speed={80} />
        <Marquee items={[...strip].reverse()} dir="right" speed={96} />
      </div>
    </div>
    <RoomCatalog variant="b" />
    <NextUp class="next-up--b" />
  </main>
  <Messengers />
  <Popups />
</Base>

<script>
  import { initSmoothScroll, initMagnetic, initCursor, initMarquee } from "../scripts/motion";
  import { initHeroB } from "../scripts/hero-b";
  initSmoothScroll();
  initHeroB(document.querySelector("[data-hero-b]")!);
  initMarquee();
  initMagnetic();
  initCursor();
</script>
