---
// Страница акции /akcii/<slug>: заголовок, суть, условия ([уточнить]), действие, другие акции.
// TODO: подробные условия и сроки акций — от заказчика.
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Footer from "../../components/sections/Footer.astro";
import Messengers from "../../components/Messengers.astro";
import Icon from "../../components/Icon.astro";
import PromoCards from "../../components/home/PromoCards.astro";
import Occasions from "../../components/home/Occasions.astro";
import { PROMO_PAGES, type PromoPage } from "../../lib/promos";
import "../../styles/components.css";
import "../../styles/b.css";
import "../../styles/sections.css";
import "../../styles/theme-dark.css";
import "../../styles/home.css";

export function getStaticPaths() {
  return PROMO_PAGES.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: PromoPage };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = p.link ? { label: p.link.label, href: p.link.href === "menu" ? `${base}/menu` : p.link.href, ext: p.link.href.startsWith("http") } : null;
---
<Base
  title={`${p.title} — акция, Время веселиться, Петербург`}
  description={`${p.title}. ${p.text}`}
  theme="#151515"
  favicon="blue"
  bodyClass="vb"
>
  <SiteHeader variant="b" home={false} />
  <main id="main" tabindex="-1" class="pv">
    <section class="pv__hero" aria-labelledby="pv-title">
      <div class="container pv__hero-in pv__hero-in--promo">
        <nav class="crumbs" aria-label="Навигация">
          <a href={`${base}/`}>Главная</a><span aria-hidden="true">/</span><a href={`${base}/#promos`}>Акции</a>
        </nav>
        <div class="pv__copy">
          <b class="pv__big num" aria-hidden="true">{p.big}</b>
          <h1 id="pv-title" class="pv__title">{p.title}</h1>
          <p class="pv__line">{p.text}</p>
          <div class="hm__ctas">
            {link ? (
              <a class="hm__btn hm__btn--main" href={link.href} target={link.ext ? "_blank" : undefined} rel={link.ext ? "noopener" : undefined}>
                {link.label} <Icon name="arrow" size={20} />
              </a>
            ) : (
              <a class="hm__btn hm__btn--main" href={`${base}/#rooms`}>Выбрать зал <Icon name="arrow" size={20} /></a>
            )}
            <a class="hm__btn" href={`${base}/#booking`}>Забронировать</a>
          </div>
        </div>
      </div>
    </section>

    <section class="blk" aria-labelledby="cond-title">
      <div class="container">
        <h2 class="blk__title" id="cond-title">Условия</h2>
        <p class="pv__todo">Сроки, ограничения и как воспользоваться акцией «{p.title}» — [уточнить].</p>
      </div>
    </section>

    <PromoCards id="drugie-akcii" title="Другие акции" exclude={p.slug} />
    <Occasions id="drugie" title="Поводы" />
  </main>
  <Footer />
  <Messengers />
</Base>
